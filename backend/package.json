{
  "name": "digital-signage-backend",
  "version": "0.1.0",
  "description": "Digital Signage SaaS Backend",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node dist/database/migrate.js",
    "migrate:status": "node dist/database/migrate.js status",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/sharp": "^0.31.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
