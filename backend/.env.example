# ============================================================
# Digital Signage — Backend Environment Variables
# Copy this to .env and fill in values, or run:
#   node ../scripts/setup-env.js
# ============================================================

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=signage
DB_PASSWORD=strong-password
DB_NAME=digital_signage

# Redis (BullMQ Queue)
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# MinIO (Object Storage)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=digital-signage
MINIO_USE_SSL=false
# Public URL browsers use to reach MinIO (leave empty for local dev)
MINIO_PUBLIC_URL=https://md.display.rizki-tech.com

# Workers
# Set to 'true' to enable BullMQ media processing workers
WORKERS_ENABLED=true
